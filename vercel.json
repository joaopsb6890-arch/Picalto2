{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/**/*", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/picalai/status", "destination": "/api/picalai" },
    { "source": "/api/picalai/chat", "destination": "/api/picalai" }
  ]
}
